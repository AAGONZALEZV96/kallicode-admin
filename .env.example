# =============================================================================
# Consola de Administración · configuración local
# Dos cadenas de conexión con dos roles distintos: no las unifiques (§18).
# El arranque falla si alguna apunta a un superusuario.
# =============================================================================
KC_ADMIN_ENV=local

# Rol de escritura: solo el esquema admin. No lee datos de cliente.
KC_ADMIN_DATABASE_URL_APP=postgresql+asyncpg://kallicode_admin_app:cambiame@localhost:5432/kallicode
# Rol de lectura analítica cross-tenant, acotado por política y por columna.
KC_ADMIN_DATABASE_URL_RO=postgresql+asyncpg://kallicode_admin_ro:cambiame@localhost:5432/kallicode

# Identidad del personal (§18.1-18.8)
KC_ADMIN_STAFF_EMAIL_DOMAINS=kallicode.com
KC_ADMIN_JWT_ISSUER=kallicode-admin
KC_ADMIN_JWT_AUDIENCE=admin-v1

# Contrato de telemetría del pipeline (§17.14-17.16), que construye E2
KC_ADMIN_TELEMETRY_BASE_URL=http://localhost:8001/internal/v1

# Red: la consola no se publica nunca (ADM-G10)
KC_ADMIN_ALLOWED_HOSTS=localhost,127.0.0.1

# Heredado de la plataforma (kallicode_core): Redis, blob y claves RSA
KC_REDIS_URL=redis://localhost:6379/2
KC_BLOB_ACCOUNT_URL=http://localhost:10000/devstoreaccount1
# KC_JWT_PRIVATE_KEY / KC_JWT_PUBLIC_KEY: obligatorias fuera de local
